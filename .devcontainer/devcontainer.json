{
    "name": "resume-builder",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "VARIANT": "22"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bradlc.vscode-tailwindcss",
                "GitHub.copilot"
            ]
        }
    },
    "remoteUser": "node",
    "features": {
        "ghcr.io/devcontainers/features/git:1": "os-provided"
    },
    "portsAttributes": {
        "3000": {
            "label": "Application",
            "onAutoForward": "openPreview"
        }
    },
    "forwardPorts": [
        3000
    ]
}
